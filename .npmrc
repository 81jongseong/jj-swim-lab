# pnpm 빌드 스크립트 승인 설정
# 필요한 네이티브 모듈의 빌드 스크립트 허용
enable-pre-post-scripts=true

# 특정 패키지의 빌드 스크립트 허용
# bcrypt: 비밀번호 해싱 (필수)
# ffmpeg-static: 비디오 처리
# tesseract.js: OCR 기능
# mongodb-memory-server: 테스트용 (개발 환경)
# sharp: 이미지 처리
# canvas: 이미지 처리

# pnpm approve-builds를 통해 승인된 패키지
# 이 설정은 pnpm approve-builds 명령어로 수동으로 설정해야 합니다.
# 터미널에서 다음 명령어 실행:
# pnpm approve-builds
# 그 후 bcrypt, ffmpeg-static, tesseract.js, mongodb-memory-server, sharp, canvas 선택

