# =============================================================================
# 🔗 DATABASE CONFIGURATION
# =============================================================================
# 📋 **의존성**: 
#   - MongoDB Atlas 클러스터 (클라우드 데이터베이스)
#   - 모든 모델 파일들과 연동 (User, Center, Course, Payment, Booking 등)
#   - db.ts 파일에서 연결 설정
# 🔄 **기능**: 
#   - 애플리케이션의 모든 데이터 저장소
#   - 사용자 인증, 센터 관리, 강습 과정, 결제 정보 등 모든 데이터 관리
# ⚠️ **주의사항**: 
#   - 프로덕션 환경에서는 반드시 안전한 URI 사용
#   - 연결 문자열에 사용자명/비밀번호 포함되어 있어 보안 주의
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# 📋 **의존성**: 
#   - scripts/fix-and-seed-data.js (샘플 데이터 생성 스크립트)
#   - 모든 모델 파일들과 연동
# 🔄 **기능**: 
#   - 개발 환경에서 자동으로 테스트 데이터 생성
#   - 사용자 계정, 센터 정보, 강습 과정 등 초기 데이터 설정
# ⚠️ **주의사항**: 
#   - 개발 환경에서만 true로 설정
#   - 프로덕션에서는 반드시 false로 설정
CREATE_SAMPLE_DATA=false

# =============================================================================
# 🚀 REDIS CONFIGURATION (Optional - for caching)
# =============================================================================
# 📋 **의존성**: 
#   - Redis 서버 (현재 미구현, 향후 캐싱용)
#   - middleware/cache.ts (캐싱 미들웨어)
# 🔄 **기능**: 
#   - 세션 저장, 캐싱, 실시간 데이터 관리
#   - 현재는 미사용이지만 향후 성능 최적화용
# ⚠️ **주의사항**: 
#   - 현재 프로젝트에서는 사용하지 않음
#   - 향후 캐싱 시스템 구축 시 활용 예정
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# 🌐 SERVER CONFIGURATION
# =============================================================================
# 📋 **의존성**: 
#   - src/index.ts (메인 서버 파일)
#   - Express.js 애플리케이션
# 🔄 **기능**: 
#   - 서버 포트 설정 (5000)
#   - 개발/프로덕션 환경 구분
#   - 클라이언트 URL 설정 (CORS용)
# ⚠️ **주의사항**: 
#   - 포트 충돌 시 다른 포트 사용 가능
#   - CLIENT_URL은 CORS 설정에 영향
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# =============================================================================
# 🔐 JWT CONFIGURATION
# =============================================================================
# 📋 **의존성**: 
#   - middleware/auth.ts (인증 미들웨어)
#   - routes/auth.ts (로그인/로그아웃 API)
#   - 클라이언트 useAuth.tsx (인증 상태 관리)
# 🔄 **기능**: 
#   - 사용자 인증 토큰 생성 및 검증
#   - 로그인 상태 유지
#   - API 접근 권한 제어
# ⚠️ **주의사항**: 
#   - JWT_SECRET은 반드시 강력한 비밀키 사용
#   - 프로덕션에서는 환경변수로 보호
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# =============================================================================
# 🚦 RATE LIMITING
# =============================================================================
# 📋 **의존성**: 
#   - middleware/rateLimit.ts (현재 미구현)
#   - Express.js rate limiting 미들웨어
# 🔄 **기능**: 
#   - API 요청 빈도 제한으로 서버 보호
#   - DDoS 공격 방지
# ⚠️ **주의사항**: 
#   - 현재는 설정만 있고 미구현 상태
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# 📁 FILE UPLOAD
# =============================================================================
# 📋 **의존성**: 
#   - routes/center-info.ts (이미지 업로드 API)
#   - multer 미들웨어
#   - uploads/ 디렉토리
# 🔄 **기능**: 
#   - 센터 이미지, 사용자 프로필 이미지 업로드
#   - 파일 크기 제한 및 저장 경로 설정
# ⚠️ **주의사항**: 
#   - uploads/ 디렉토리 자동 생성 필요
#   - 파일 크기는 10MB로 제한
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# =============================================================================
# 📧 EMAIL CONFIGURATION (Optional)
# =============================================================================
# 📋 **의존성**: 
#   - nodemailer 패키지 (현재 미구현)
#   - 이메일 발송 서비스
# 🔄 **기능**: 
#   - 비밀번호 재설정, 알림 이메일 발송
#   - 현재는 미구현 상태
# ⚠️ **주의사항**: 
#   - 향후 알림 시스템 구축 시 활용 예정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# =============================================================================
# ⚡ PERFORMANCE OPTIMIZATION
# =============================================================================
# 📋 **의존성**: 
#   - Express.js compression 미들웨어
#   - 로깅 시스템
# 🔄 **기능**: 
#   - 응답 압축으로 네트워크 성능 향상
#   - 캐시 TTL 설정
#   - 로그 레벨 조정
# ⚠️ **주의사항**: 
#   - 개발 환경에서는 info 레벨 권장
COMPRESSION_LEVEL=6
CACHE_TTL=300
LOG_LEVEL=info

# =============================================================================
# 🛡️ SECURITY
# =============================================================================
# 📋 **의존성**: 
#   - helmet 패키지 (보안 헤더)
#   - CORS 미들웨어
# 🔄 **기능**: 
#   - 보안 헤더 자동 설정
#   - Cross-Origin 요청 제어
# ⚠️ **주의사항**: 
#   - CORS_ORIGIN은 클라이언트 URL과 일치해야 함
HELMET_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# 📊 MONITORING & ANALYTICS
# =============================================================================
# 📋 **의존성**: 
#   - Sentry 에러 추적 시스템
#   - Google Analytics
#   - 성능 모니터링 도구
# 🔄 **기능**: 
#   - 서버 에러 추적 및 모니터링
#   - 성능 메트릭 수집
#   - 사용자 행동 분석
# ⚠️ **주의사항**: 
#   - 프로덕션에서는 전문 모니터링 도구 사용 권장
#   - 민감한 정보 필터링 필요
ENABLE_MONITORING=true
LOG_TO_FILE=true

# Sentry 에러 추적
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX
GA_ENABLED=true

# 성능 모니터링
PERFORMANCE_MONITORING=true
WEB_VITALS_ENABLED=true
API_RESPONSE_TIME_THRESHOLD=1000

# 로그 레벨 및 설정
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ROTATION=true
MAX_LOG_FILES=10
MAX_LOG_SIZE=10MB 