                        {method.id === 'even' && '"앞뒤 똑같은 속도로"'}
                        {method.id === 'ladder' && '"거리를 점점 늘리거나 줄이기"'}
                        {method.id === 'pyramid' && '"거리를 늘렸다가 다시 줄이기"'}
