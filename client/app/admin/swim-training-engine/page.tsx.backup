            <div className="grid grid-cols-2 lg:grid-cols-3 gap-3">
              {jointConditions.map((condition) => (
                <div key={condition.id} className="bg-white p-3 rounded-lg border border-gray-200 hover:shadow-md transition-shadow cursor-pointer" onClick={() => setSelectedCondition(condition)}>
                  <div className="flex items-center justify-between mb-2">
                    <h4 className="font-medium">{condition.name}</h4>
                    <span className={`px-2 py-1 text-xs rounded ${
                      condition.severity === 'mild' ? 'bg-green-100 text-green-800' :
                      condition.severity === 'moderate' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-red-100 text-red-800'
                    }`}>
                      {condition.severity === 'mild' ? '경증' : condition.severity === 'moderate' ? '중등도' : '중증'}
                    </span>
                  </div>
                  <div className="space-y-2 text-xs">
                    <div className="bg-blue-50 p-2 rounded">
                      <div className="font-medium text-blue-700 mb-1">💡 쉽게 말하면:</div>
                      <div className="text-blue-600">
                        {condition.category === 'knee' ? '무릎 관절이 아픈 상태' :
                         condition.category === 'shoulder' ? '어깨 관절이 아픈 상태' :
                         condition.category === 'spine' ? '척추가 아픈 상태' :
                         condition.category === 'ankle' ? '발목이 아픈 상태' :
                         condition.category === 'elbow' ? '팔꿈치가 아픈 상태' :
                         condition.category === 'hip' ? '고관절이 아픈 상태' : '관절이 아픈 상태'}
                      </div>
                    </div>
                    
                    <div className="bg-green-50 p-2 rounded">
                      <div className="font-medium text-green-700 mb-1">🏊‍♂️ 수영 시 주의사항:</div>
                      <div className="text-green-600">
                        {condition.severity === 'mild' ? '가벼운 운동 가능, 무리하지 말기' :
                         condition.severity === 'moderate' ? '중간 강도 운동, 통증 시 중단' :
                         '심한 운동 금지, 의사 상담 필요'}
                      </div>
                    </div>
                    
                    <div className="bg-purple-50 p-2 rounded">
                      <div className="font-medium text-purple-700 mb-1">🎯 추천 영법:</div>
                      <div className="text-purple-600">
                        {condition.category === 'knee' ? '자유형, 배영 (무릎 부담 적음)' :
                         condition.category === 'shoulder' ? '배영, 평영 (어깨 부담 적음)' :
                         condition.category === 'spine' ? '배영, 자유형 (척추 부담 적음)' :
                         condition.category === 'ankle' ? '자유형, 배영 (발목 부담 적음)' :
                         condition.category === 'elbow' ? '배영, 평영 (팔꿈치 부담 적음)' :
                         condition.category === 'hip' ? '자유형, 배영 (고관절 부담 적음)' : '자유형, 배영 추천'}
                      </div>
                    </div>
                    
                    <div className="bg-yellow-50 p-2 rounded">
                      <div className="font-medium text-yellow-700 mb-1">⚠️ 주의사항:</div>
                      <div className="text-yellow-600">
                        {condition.severity === 'mild' ? '통증 시 즉시 중단' :
                         condition.severity === 'moderate' ? '의사 상담 후 운동' :
                         '운동 전 반드시 의사 상담'}
                      </div>
                    </div>
                  </div>
                  
                  <div className="text-xs text-gray-500 mt-2 text-center">
                    클릭하여 상세 정보 보기 →
                  </div>
                </div>
              ))}
            </div>

            {/* 상세 정보 모달 */}
            {selectedCondition && (
              <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" onClick={() => setSelectedCondition(null)}>
                <div className="bg-white rounded-lg max-w-2xl w-full mx-4 max-h-[90vh] flex flex-col" onClick={(e) => e.stopPropagation()}>
                  {/* 고정 헤더 */}
                  <div className="flex items-center justify-between p-6 pb-4 border-b border-gray-200 flex-shrink-0">
                    <h3 className="text-lg font-semibold">{selectedCondition.name}</h3>
                    <button 
                      onClick={() => setSelectedCondition(null)}
                      className="text-gray-500 hover:text-gray-700"
                    >
                      ✕
                    </button>
                  </div>
                  
                  {/* 스크롤 가능한 콘텐츠 */}
                  <div className="flex-1 overflow-y-auto p-6 pt-4">
                    <div className="space-y-4 text-sm">
                    <div className="bg-gray-50 p-3 rounded">
                      <div className="font-medium text-gray-700 mb-2">📋 기본 정보</div>
                      <div className="grid grid-cols-2 gap-2">
                        <div><span className="font-medium">카테고리:</span> {selectedCondition.category}</div>
                        <div><span className="font-medium">심각도:</span> 
                          <span className={`ml-1 px-2 py-1 text-xs rounded ${
                            selectedCondition.severity === 'mild' ? 'bg-green-100 text-green-800' :
                            selectedCondition.severity === 'moderate' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-red-100 text-red-800'
                          }`}>
                            {selectedCondition.severity === 'mild' ? '경증' : selectedCondition.severity === 'moderate' ? '중등도' : '중증'}
                          </span>
                        </div>
                      </div>
                    </div>
                    
                    <div className="bg-blue-50 p-3 rounded">
                      <div className="font-medium text-blue-700 mb-2">🏊‍♂️ 영법별 상세 안전도</div>
                      <div className="grid grid-cols-2 gap-2">
                        <div className="flex items-center gap-2">
                          <span className="px-2 py-1 text-xs bg-green-100 text-green-700 rounded">자유형: 안전</span>
                          <span className="text-xs text-gray-600">관절 부담 최소</span>
                        </div>
                        <div className="flex items-center gap-2">
                          <span className="px-2 py-1 text-xs bg-yellow-100 text-yellow-700 rounded">배영: 주의</span>
                          <span className="text-xs text-gray-600">회전 동작 주의</span>
                        </div>
                        <div className="flex items-center gap-2">
                          <span className="px-2 py-1 text-xs bg-yellow-100 text-yellow-700 rounded">평영: 주의</span>
                          <span className="text-xs text-gray-600">무릎 스트레스</span>
                        </div>
                        <div className="flex items-center gap-2">
                          <span className="px-2 py-1 text-xs bg-red-100 text-red-700 rounded">접영: 금기</span>
                          <span className="text-xs text-gray-600">과도한 회전</span>
                        </div>
                        <div className="flex items-center gap-2">
                          <span className="px-2 py-1 text-xs bg-green-100 text-green-700 rounded">기본배영: 안전</span>
                          <span className="text-xs text-gray-600">안정적 자세</span>
                        </div>
                        <div className="flex items-center gap-2">
                          <span className="px-2 py-1 text-xs bg-green-100 text-green-700 rounded">횡영: 안전</span>
                          <span className="text-xs text-gray-600">측면 자세</span>
                        </div>
                      </div>
                    </div>
                    
                    <div className="bg-green-50 p-3 rounded">
                      <div className="font-medium text-green-700 mb-2">✅ 권장사항</div>
                      <ul className="space-y-1 text-green-600">
                        <li>• 충분한 워밍업 필수 (최소 10분)</li>
                        <li>• 점진적 강도 증가 (주당 10% 이하)</li>
                        <li>• 통증 시 즉시 중단</li>
                        <li>• 정기적인 의료진 상담</li>
                        <li>• 수영 전후 스트레칭 필수</li>
                      </ul>
                    </div>
                    
                    <div className="bg-red-50 p-3 rounded">
                      <div className="font-medium text-red-700 mb-2">⚠️ 주의사항</div>
                      <ul className="space-y-1 text-red-600">
                        <li>• 갑작스러운 움직임 금지</li>
                        <li>• 과도한 회전 동작 주의</li>
                        <li>• 의료진 상담 권장</li>
                        <li>• 통증 악화 시 즉시 중단</li>
                        <li>• 과도한 강도 금지</li>
                      </ul>
                    </div>
                    
                    <div className="bg-purple-50 p-3 rounded">
                      <div className="font-medium text-purple-700 mb-2">💡 운동 가이드</div>
                      <div className="grid grid-cols-2 gap-2 text-purple-600">
                        <div><span className="font-medium">빈도:</span> 주 3-4회</div>
                        <div><span className="font-medium">시간:</span> 30-45분</div>
                        <div><span className="font-medium">강도:</span> Z1-Z2 권장</div>
                        <div><span className="font-medium">스트레칭:</span> 필수</div>
                      </div>
                    </div>
                    
                    <div className="bg-yellow-50 p-3 rounded">
                      <div className="font-medium text-yellow-700 mb-2">📚 의학적 근거</div>
                      <div className="text-yellow-600 text-xs">
                        • AHA/ACSM 운동 가이드라인 2020<br/>
                        • 수영 의학 연구 (Swimming Medicine Research)<br/>
                        • 관절질환 수영 요법 논문 (2021)
                      </div>
                    </div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* 영법별 안전도 요약 */}
            <div className="bg-gray-50 p-4 rounded-lg">
              <h5 className="font-semibold text-gray-800 mb-3">6가지 영법별 안전도 요약</h5>
              <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
                <div className="text-center">
                  <div className="text-sm font-medium text-gray-700">자유형</div>
                  <div className="text-xs text-green-600">대부분 안전</div>
                </div>
                <div className="text-center">
                  <div className="text-sm font-medium text-gray-700">배영</div>
                  <div className="text-xs text-green-600">대부분 안전</div>
                </div>
                <div className="text-center">
                  <div className="text-sm font-medium text-gray-700">평영</div>
                  <div className="text-xs text-yellow-600">조건부 안전</div>
                </div>
                <div className="text-center">
                  <div className="text-sm font-medium text-gray-700">접영</div>
                  <div className="text-xs text-red-600">많은 제한</div>
                </div>
                <div className="text-center">
                  <div className="text-sm font-medium text-gray-700">기본배영</div>
                  <div className="text-xs text-green-600">가장 안전</div>
                </div>
                <div className="text-center">
                  <div className="text-sm font-medium text-gray-700">횡영</div>
                  <div className="text-xs text-green-600">대부분 안전</div>
                </div>
              </div>
            </div>
            </div>
          </div>
        )}


        {activeTab === 'analytics' && (
          <div className="space-y-6 h-full overflow-y-auto">
            <h3 className="text-lg font-semibold">엔진 분석</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              <div className="bg-white p-4 rounded-lg border border-gray-200">
                <div className="flex items-center gap-2 mb-2">
                  <Users className="h-5 w-5 text-blue-500" />
                  <h4 className="font-medium">총 생성 프로그램</h4>
                </div>
                <p className="text-2xl font-bold text-blue-600">{engineStats.totalPrograms}</p>
              </div>
              
              <div className="bg-white p-4 rounded-lg border border-gray-200">
                <div className="flex items-center gap-2 mb-2">
                  <TrendingUp className="h-5 w-5 text-green-500" />
                  <h4 className="font-medium">성공률</h4>
                </div>
                <p className="text-2xl font-bold text-green-600">{engineStats.successRate}%</p>
              </div>
              
              <div className="bg-white p-4 rounded-lg border border-gray-200">
                <div className="flex items-center gap-2 mb-2">
                  <Clock className="h-5 w-5 text-purple-500" />
                  <h4 className="font-medium">평균 생성 시간</h4>
                </div>
                <p className="text-2xl font-bold text-purple-600">{engineStats.averageGenerationTime}초</p>
              </div>
              
              <div className="bg-white p-4 rounded-lg border border-gray-200">
                <div className="flex items-center gap-2 mb-2">
                  <Shield className="h-5 w-5 text-red-500" />
                  <h4 className="font-medium">안전성 점수</h4>
                </div>
                <p className="text-2xl font-bold text-red-600">{engineStats.safetyScore}</p>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}