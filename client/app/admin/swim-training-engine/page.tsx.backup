                        {method.id === 'fartlek' && '"속도를 자유롭게 바꾸기"'}
                        {method.id === 'tempo_trainer' && '"비프 소리에 맞춰 수영"'}
                        {method.id === 'threshold' && '"오래 유지할 수 있는 최대 속도"'}
                        {method.id === 'vo2' && '"짧고 강한 인터벌"'}
                        {method.id === 'sprint' && '"전력으로 짧게"'}
                        {method.id === 'kick' && '"다리만으로 수영"'}
                        {method.id === 'pull' && '"팔만으로 수영"'}
                        {method.id === 'drillswim' && '"드릴과 수영을 번갈아"'}
                        {method.id === 'choice' && '"각자 다른 과제"'}
                        {method.id === 'pace_clock' && '"시계를 보고 페이스 맞추기"'}
                        {method.id === 'rp25' && '"레이스 속도로 짧게"'}
                        {method.id === 'turn_focus' && '"턴에 집중해서"'}
