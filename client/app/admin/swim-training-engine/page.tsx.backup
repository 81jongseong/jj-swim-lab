                        {method.id === 'skps' && '"수영-킥-풀-수영 순서로"'}
                        {!['descend', 'ascend', 'build', 'neg_split', 'even', 'ladder', 'pyramid', 'broken', 'fartlek', 'tempo_trainer', 'threshold', 'vo2', 'sprint', 'kick', 'pull', 'drillswim', 'choice', 'pace_clock', 'rp25', 'turn_focus', 'sr_lock', 'hypoxic_set', 'aerobic_mix', 'quality', 'progress', 'recovery', 'skps'].includes(method.id) && method.definition}
