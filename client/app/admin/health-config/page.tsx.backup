      formula: '목표심박수 = 안정시심박수 + (최대심박수 - 안정시심박수) × 운동강도(%)',
      parameters: {
        intensity: { type: 'percentage', min: 40, max: 90, default: 70 },
        maxHeartRate: { type: 'number', min: 150, max: 220, default: 220 },
